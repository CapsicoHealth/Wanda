             ]
           ,"orderBy":["lastAccessDt"]
          }
        ]
      ,"outputMaps": [
          { "name": ""      , "outTypes":["JSON","CSV"], "columns": [ "*" ] }
         ,{ "name": "export", "outTypes":["JSON"]      , "columns": [ "*" ], "exclude":["userRefnum", "tourId", "takenSteps", "totalSteps"] }
        ]
     }
     
     
