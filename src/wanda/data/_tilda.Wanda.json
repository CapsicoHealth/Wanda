          ,{ "name":"inviteeEmail"       , "type"  :"STRING(255)"        , "nullable":false, "invariant":true , "description":"Email of the invited person - canonical lookup key before a User account exists" }
          ,{ "name":"inviteeNameFirst"   , "type"  :"STRING(255)"        , "nullable":false, "invariant":true , "description":"First name of the invited person" }
          ,{ "name":"inviteeNameLast"    , "type"  :"STRING(255)"        , "nullable":false, "invariant":true , "description":"Last name of the invited person" }
          ,{ "name":"inviteeRefnum"      , "sameas":"User.refnum"        , "nullable":true                    , "description":"FK to User once the account exists; null when invitee is not yet registered"    }
          ,{ "name":"inviteeUserId"      , "sameas":"User.id"            , "nullable":true                    , "description":"Denorm of invitee user id; null until the account exists"                       }
          ,{ "name":"role"               , "type"  :"CHAR"               , "nullable":false                   , "description":"OrganizationACL role to be granted on acceptance (Admin/Writer/Reader - Owner cannot be granted via invite)"
                                         , "values": [ { "name":"Admin" , "value":"A", "description":"Admin (can edit, manage ACL)" }
                                                      ,{ "name":"Writer", "value":"W", "description":"Can read and create/edit organization content" }
                                                      ,{ "name":"Reader", "value":"R", "description":"Read-only access" }
                                                     ]
            }
          ,{ "name":"inviteToken"        , "type"  :"STRING( 20)"        , "nullable":true                    , "description":"One-time random token for the accept/decline link; used for Scenario A (existing active user). Null for Scenario B (new user - org join is triggered automatically from UserOnBoarding via inviteeRefnum)." }
          ,{ "name":"inviteTokenCreated" , "type"  :"DATETIME"           , "nullable":true                    , "description":"When inviteToken was generated, for TTL enforcement"                            }
          ,{ "name":"status"             , "type"  :"STRING(2)"          , "nullable":false                   , "description":"Invite lifecycle status"
                                         , "values": [ { "name":"Pending"  , "value":"PE", "description":"Invitation sent, awaiting response", "default":"CREATE" }
                                                      ,{ "name":"Accepted" , "value":"AC", "description":"Invitation accepted" }
                                                      ,{ "name":"Declined" , "value":"DC", "description":"Invitation declined by invitee" }
                                                      ,{ "name":"Cancelled", "value":"CN", "description":"Invitation cancelled by the org admin/owner" }
