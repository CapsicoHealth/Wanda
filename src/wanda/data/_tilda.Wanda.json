         ]
       ,"indices": [
           { "name":"OrgEmailPending", "columns":["organizationRefnum", "inviteeEmail"], "subWhere":"status='PE' and deleted is null", "db":true                   }
          ,{ "name":"InviteToken"    , "columns":["inviteToken"]                       , "subWhere":"inviteToken is not null and deleted is null", "db":true       }
          ,{ "name":"InviteePending" , "columns":["inviteeRefnum"]                     , "subWhere":"status='PE' and deleted is null"                             }
          ,{ "name":"OrgPending"     , "columns":["organizationRefnum"]                , "subWhere":"status='PE' and deleted is null", "orderBy":["created desc"] }
         ]
       ,"queries": [
          { "name"  :"ByToken"
           ,"description":"Look up an invite by its accept/decline token - used by AcceptOrgInvite and DeclineOrgInvite (Scenario A: existing active user)"
           ,"from"  :[]
           ,"wheres":[ { "db":"*", "clause":"inviteToken=?() and deleted is null" } ]
          }
         ,{ "name"  :"ByInviteePending"
           ,"description":"Find all pending org invites for a given inviteeRefnum - used by UserOnBoarding to auto-join organisations after registration (Scenario B: new user)"
           ,"from"  :[]
           ,"wheres":[ { "db":"*", "clause":"inviteeRefnum=?() and status='PE' and deleted is null" } ]
           ,"orderBy":["created asc"]
          }
         ,{ "name"  :"ByOrgPending"
           ,"description":"List all pending invites for a given organization - used by ListOrgInvites for admin/owner review"
           ,"from"  :[]
           ,"wheres":[ { "db":"*", "clause":"organizationRefnum=?() and status='PE' and deleted is null" } ]
           ,"orderBy":["created desc"]
          }
         ]
       ,"outputMaps": [
           { "name":"", "outTypes":["JSON","CSV"], "columns":["*"] }
         ]
      }

