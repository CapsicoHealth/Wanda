    ,{ "name": "ExpressionTemplate"
      ,"mode":"CODE_ONLY"
      ,"description": "Reusable template to drive boolean expressions in a json format for the FLORIA Expression Editor component"
      ,"columns": [
          { "name":"e", "type"  :"JSON[]", "nullable":true, "description":"Boolean expression with variables, operators, functions and values"
                      , "jsonSchema": {
                           "typeName": "ValidationRule"
                          ,"description": "A recursive boolean-logic tree for validating the agent response, matching the shape produced and consumed by the FLORIA Expression Editor (module-expression-editor.js). A rule list is evaluated as a strictly left-to-right fold with no operator precedence: the first element's 'op' is ignored (there is nothing before it to combine with), and every subsequent element's 'op' ('and'/'or') combines that element's own value with the running result so far. A rule is EITHER a leaf (it carries an 'expr', i.e., a single var/f/vals test) OR a group (it carries a 'sub', i.e., a nested rule list evaluated by this same fold and then treated as one parenthesized value) - never both, and never neither. 'not':true negates that rule's own value, whether it is a leaf or a whole group. To force grouping/precedence (e.g., 'A and (B or C)'), nest the lower-precedence combination in a child rule's 'sub' rather than listing it as a sibling."
                          ,"fields": [
                              {"name":"op", "type":"STRING"  , "description":"Operator for the expression, being OR or AND. Note: The first 'sibling' in a list would have no operator)."
                                          , "values": [
                                                { "name":"and", "description":"And clause"   }
                                               ,{ "name":"or" , "description":"Or clause" }
                                              ]
                              }
                             ,{"name":"not"   , "type":"BOOLEAN", "description":"Negation for the expression, being true or false." }
                             ,{"name":"expr"  , "type":"JSON"   , "description":"A leaf validation expression, i.e., a single var/f/vals test. Set on a leaf rule only, and mutually exclusive with 'sub'."
                                              , "jsonSchema": {
                                                   "typeName": "ValidationExpression"
                                                  ,"description": "A leaf expression node holding a single value test: apply function 'f' to variable 'var' over the values in 'vals'."
                                                  ,"fields": [
                                                      { "name":"var" , "type":"STRING"  , "description":"The variable this expression applies to" }
                                                     ,{ "name":"f"   , "type":"STRING"  , "description":"A function name, e.g., 'any' for matching any value, or 'all' for matching all values." }
                                                     ,{ "name":"vals", "type":"STRING[]", "description":"One or more values (case-insensitive 'indexOf' matching)" }
                                                    ]
                                                 }
                              }
                             ,{"name":"sub"   , "type":"JSON[]" , "description":"A nested rule list, making this rule a group rather than a leaf: the list is evaluated with the same left-to-right fold, and its result is treated as one parenthesized value that this rule's own 'op' then combines with its siblings (and its own 'not' negates as a whole). Set on a group rule only, and mutually exclusive with 'expr'."
                                              , "jsonSchema": {
                                                   "typeName": "ExpressionTemplate.ValidationRule"
                                                 }
                              }
                            ]
                          ,"validation": { 
                              "descr":"A rule has an optional op, and is either a leaf (expr) or a group (sub), but never both and never neither"
                             ,"rule": [
                                 "(   expr is not null and sub is NOE"
                                ," or expr is null and sub is not NOE"
                                ,")"
                                ,"and (op is NOE or op in ('and','or'))"
                               ]
                            }
                         }
          }
        ]
      ,"primary": { "autogen": true, "keyBatch": 5000 }        
     }



     

