   ,{ "name":"UserPlanCreditLedger"
     ,"lc":"WORM"
     ,"descriptionX":[
         "WORM (append-only) ledger of every credit movement for pre-paid (planType=C) plans. This is the SOURCE OF TRUTH:"
        ,"UserPlanSubscription.creditsBalance is only a denormalized cache and can be rebuilt from here with a SUM(amount)"
        ,"per subscription. Rows are NEVER updated or deleted. Amounts are in credit UNITS (1 credit = 1 US cent by convention),"
        ,"deliberately currency-agnostic: the pack price varies per market, the credits granted do not."
       ]
     ,"columns": [
         {"name":"userRefnum"        , "sameAs":"User.refnum"                , "nullable":false, "description":"User Foreign Key, denormalized for direct user-scoped queries." }
        ,{"name":"organizationRefnum", "sameAs":"Organization.refnum"        , "nullable":true , "description":"Organization Foreign Key (optional)." }
        ,{"name":"projectRefnum"     , "sameAs":"Project.refnum"             , "nullable":true , "description":"Project Foreign Key (optional)." }
        ,{"name":"subscriptionRefnum", "sameAs":"UserPlanSubscription.refnum", "nullable":false, "description":"The credit wallet (subscription) this movement applies to." }
        ,{"name":"billingRefnum"     , "sameAs":"UserPlanBilling.refnum"     , "nullable":true , "description":"The purchase that paid for this movement. Set for GRANT rows, null for USE/ADJ." }
        ,{"name":"paymentSystemProductId", "sameAs":"Plan.paymentSystemProductId", "nullable":false, "description":"The product grouping key, denormalized for direct product-scoped queries." }
        ,{"name":"type"              , "type":"STRING(10)"                   , "nullable":false, "description":"The nature of this credit movement."
                                     , "values": [
                                          {"name":"Grant"     , "value":"GRANT", "description":"Credits granted by a successful purchase." }
                                         ,{"name":"Use"       , "value":"USE"  , "description":"Credits consumed by a metered action."     }
                                         ,{"name":"Bonus"     , "value":"BONUS", "description":"One-time promo signup-bonus credits (Promo.initialCredits), granted alongside a Grant on a user's first credit-pack purchase for a product under a promo that defines a bonus." }
                                         ,{"name":"Adjustment", "value":"ADJ"  , "description":"Manual/admin correction."                  }
                                        ]
         }
        ,{"name":"amount"            , "type":"NUMERIC"                      , "nullable":false, "description":"The signed credit units: POSITIVE for GRANT, NEGATIVE for USE, either for ADJ." }
        ,{"name":"balanceAfter"      , "type":"NUMERIC"                      , "nullable":false, "description":"Snapshot of the wallet balance right after applying this row, so an audit never needs to recompute a running total." }
        ,{"name":"itemType"          , "type":"STRING(64)"                   , "nullable":true , "description":"The type of the item being tracked, for example, 'Flow', 'Agent', 'Document'..." }
        ,{"name":"itemId"            , "type":"STRING(64)"                   , "nullable":true , "description":"The id of the item being tracked" }
        ,{"name":"itemLabel"         , "type":"STRING(1024)"                 , "nullable":true , "description":"Optional human-readable detail for the item, mostly for 'USE' rows." }
       ]
     ,"primary": { "autogen": true }
     ,"foreign":[
         { "name":"User"        , "srcColumns":["userRefnum"        ], "destObject":"User" }
