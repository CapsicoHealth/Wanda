   ,{ "name":"UserPlanPreOrder"
     ,"description":"Plan Orders submitted but not yet completed. This table should have only one order per user PER PRODUCT, as a staging area. Full orders, either completed or canceled, should be moved to UserPlanSubscription and UserPlanBilling."
     ,"columns": [
         {"name":"userRefnum"     , "sameAs":"User.refnum"         , "nullable":false, "description":"User Foreign Key" }
        ,{"name":"planRefnum"     , "sameAs":"Plan.refnum"         , "nullable":false, "description":"Plan Foreign Key" }
        ,{"name":"paymentSystemProductId", "sameAs":"Plan.paymentSystemProductId", "nullable":false, "description":"The product grouping key, denormalized from Plan so the single-in-flight-order constraint can be scoped per product. Immutable for the life of the row." }
        ,{"name":"paymentProvider", "type":"STRING(128)"           , "nullable":false, "description":"The payment provider." }
        ,{"name":"customId"       , "type":"STRING(256)"           , "nullable":false, "description":"Subscription ID." }
        ,{"name":"orderId"        , "type":"STRING(128)"           , "nullable":true , "description":"Order ID." }
        ,{"name":"orderDt"        , "type":"DATETIME"              , "nullable":false, "description":"The date the plan starts being valid (at 00:00:00 hours). Timezones can make this more complicated, so handle as appropriate." }
        ,{"name":"total"          , "type":"NUMERIC"               , "nullable":false, "description":"The price at the moment of the plan selection" }
        ,{"name":"currency"       , "sameAs":"PlanPricing.currency", "nullable":false, "description":"The currency for the billing" }
        ,{"name":"cycle"          , "type":"CHAR"                  , "nullable":false, "description":"The plan cycle"
                                  , "values": [
                                       {"name":"Monthly", "value":"M" , "description":"Monthly payments" } 
                                      ,{"name":"Yearly" , "value":"Y" , "description":"Yearly payments"  } 
                                      ,{"name":"OneTime", "value":"O" , "description":"One-time pre-paid purchase (credit pack): no recurrence, no expiry."  } 
                                     ]
         }
        ,{"name":"orderDetails"   , "type":"JSON"                  , "nullable":true , "description":"Order capture json payload." }
       ]
     ,"foreign":[
         { "name":"User", "srcColumns":["userRefnum"], "destObject":"User" }
        ,{ "name":"Plan", "srcColumns":["planRefnum" ], "destObject":"Plan"  }
       ]
     ,"indices":[
         { "name":"User", "columns":["userRefnum", "paymentSystemProductId"], "db": true  }
       ]
     ,"queries": [
       ]
    }
    
    
    ,{ "name":"UserPlanSubscription"
      ,"description":"User to Plan mapping. For planType=C (credits), this row doubles as the user's credit WALLET for the product: re-buying any tier of the same product tops up this same row rather than creating a new one."
      ,"columns": [
           {"name":"userRefnum" , "sameAs":"User.refnum", "nullable":false , "description":"User Foreign Key" }
          ,{"name":"active"     , "type":"BOOLEAN"               , "nullable": false, "description":"Whether this user plan is active or not. Any user should have at most ONE active plan PER PRODUCT they are under. When a plan is renewed or changed, the current plan should be ended (endDt=now + active-false) and a new subscription should be created" }
          ,{"name":"planRefnum" , "sameAs":"Plan.refnum", "nullable":false , "description":"Plan Foreign Key. For credit wallets, this tracks the MOST RECENTLY purchased tier and is informational only: per-purchase truth lives in UserPlanBilling." }
          ,{"name":"paymentSystemProductId", "sameAs":"Plan.paymentSystemProductId", "nullable":false, "description":"The product grouping key, denormalized from Plan so that the one-active-subscription constraint is scoped per product. Immutable for the life of the row." }
          ,{"name":"currency"   , "sameAs":"PlanPricing.currency", "nullable":false , "description":"The currency for the plan" }
          ,{"name":"cycle"      , "type":"CHAR" , "nullable": false, "description":"The plan cycle"
                                , "values": [
                                     {"name":"Monthly", "value":"M" , "description":"Monthly payments" } 
                                    ,{"name":"Yearly" , "value":"Y" , "description":"Yearly payments"  } 
                                    ,{"name":"OneTime", "value":"O" , "description":"One-time pre-paid purchase (credit pack): no recurrence, and getExpiryDtFrom() returns null so the billing never date-expires."  } 
                                   ]
           }
          ,{"name":"discountPct"    , "sameAs":"Promo.discountPct"   , "nullable": true , "description":"The discount percentage available, e.g., 25%, 50%, 100%, at the moment of the plan selection" }
          ,{"name":"discountMonths" , "sameAs":"Promo.discountMonths", "nullable": true , "description":"The number of months the discount is applicable to, i.e., first month, first 3 months etc...., at the moment of the plan selection" }
          ,{"name":"creditsBalance"  , "type":"NUMERIC"              , "nullable": true , "description":"CREDIT WALLET: the current remaining credit units. Null for planType=S. This is a denormalized cache of SUM(UserPlanCreditLedger.amount) and is rebuildable from that ledger at any time." }
          ,{"name":"creditsPurchased", "type":"NUMERIC"              , "nullable": true , "description":"CREDIT WALLET: lifetime credit units ever granted on this wallet (monotonically increasing, for reporting), including both paid GRANTs and any promo signup BONUS. Null for planType=S." }
          ,{"name":"creditsBonusGranted", "type":"NUMERIC"           , "nullable": true , "description":"CREDIT WALLET: cumulative promo signup-bonus credit units (UserPlanCreditLedger type BONUS) ever granted on this wallet, tracked separately from creditsPurchased because it is promotional, not paid. A non-null/positive value is the idempotency guard that makes Promo.initialCredits a first-purchase-only grant per product: see CreditHelper.grantSignupBonusIfEligible. Null for planType=S or for a wallet that has never received a signup bonus." }
          ,{"name":"startDt"        , "type":"DATE"                  , "nullable": false, "description":"The date the plan starts being valid (at 00:00:00 hours). Timezones can make this more complicated, so handle as appropriate." }
          ,{"name":"endDt"          , "type":"DATE"                  , "nullable": true , "description":"The date after which the plan is not valid anymore, e.g., if the value is 2024-09-10, then the Promo is valid until 23:59:59:999. Timezones can make this more complicated, so handle as appropriate." }
        ]
      ,"primary": { "autogen": true }
      ,"foreign":[
          { "name":"User", "srcColumns":["userRefnum"], "destObject":"User" }
         ,{ "name":"Plan", "srcColumns":["planRefnum" ], "destObject":"Plan"  }
        ]
      ,"indices":[
          { "name":"UserActivePlan"  , "columns":["userRefnum", "paymentSystemProductId"], "subWhere":"active = true", "db": true  }
         ,{ "name":"UserPlans"       , "columns":["userRefnum"], "orderBy":["startDt desc"], "db": true  }
        ]
      ,"queries": [
       ]
     }
     
     
